# Valfritt. Utan nyckel faller assistenten tillbaka på regelbaserade förslag.
ANTHROPIC_API_KEY=

# Lösenord för säljläget (visar listpriser). Sätts automatiskt av render.yaml.
SALES_PASSWORD=inkab

# Lösenord för adminläget (maskinbibliotek och priser).
ADMIN_PASSWORD=inkab-admin

# Valfri. Postgres-URL så att admins ändringar överlever omstart.
# Utan den lagras ändringarna i minnet och kan exporteras som JSON.
DATABASE_URL=
